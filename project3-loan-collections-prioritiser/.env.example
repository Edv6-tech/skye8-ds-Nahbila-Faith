# =====================================================================
# SKYE8 LOAN COLLECTIONS PRIORITISER — PRODUCTION ENVIRONMENT CONFIG
# Place this file as .env in the project root or home directory.
# =====================================================================

# ---------------------------------------------------------------------
# 1. INSTITUTION & BRANCH METADATA
# ---------------------------------------------------------------------
MFI_NAME="Ntarinkon Cooperative Credit Union (NtaCCUL)"
BRANCH_CODE="BMD-001"
BRANCH_NAME="Commercial Avenue Main Branch"
MFI_CODE="705001"

# ---------------------------------------------------------------------
# 2. MTN MOMO COLLECTION API CREDENTIALS
# Obtain from https://momodeveloper.mtn.com/ or MTN Business Cameroon
# ---------------------------------------------------------------------
MTN_MOMO_PRIMARY_KEY=""
MTN_MOMO_USER_ID=""
MTN_MOMO_API_SECRET=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_TARGET_ENV="production"  # Change to "production" when live

# ---------------------------------------------------------------------
# 3. ORANGE MONEY MERCHANT API CREDENTIALS
# Obtain from Orange Money WebPay API Portal (Cameroon)
# ---------------------------------------------------------------------
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_AUTH_TOKEN=""
ORANGE_MONEY_BASE_URL="https://api.orange.com/orange-money-webpay/cm/v1"

# ---------------------------------------------------------------------
# 4. SMS GATEWAY CREDENTIALS (Twilio or Local Telco REST Gateway)
# ---------------------------------------------------------------------
SMS_PROVIDER="TWILIO"  # "TWILIO", "GENERIC_REST", or "MOCK"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

GENERIC_SMS_API_URL="https://api.sms-gateway.cm/v1/send"
GENERIC_SMS_API_KEY=""

# ---------------------------------------------------------------------
# 5. WHATSAPP BUSINESS API CREDENTIALS
# Obtain from Meta Developers Portal (WhatsApp Cloud API)
# ---------------------------------------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---------------------------------------------------------------------
# 6. CORE BANKING SYSTEM (CBS) DATABASE CONNECTION
# ---------------------------------------------------------------------
DB_TYPE="sqlite"  # "sqlite", "postgres", or "mysql"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="skye8_collections_db"
DB_USER="postgres"
DB_PASSWORD=""
